            promptToDivide,
            add_special_tokens=True,
            truncation=True,
            max_length=256,
        )["input_ids"]
        tokens = tokenizer.convert_ids_to_tokens(token_ids)
        words, vecs = [], []
        cur_word, cur_vecs = "", []
        for tok, vec in zip(tokens, output):
            if tok in tokenizer.all_special_tokens:
                continue
            if tok.startswith("##"):
                cur_word += tok[2:]
                cur_vecs.append(vec)
            else:
