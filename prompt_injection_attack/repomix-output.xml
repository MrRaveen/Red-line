async def clean_prompt_with_llm(state: graphState) -> Dict[str, Any]:
    raw = state.get("currentInputPrompt", "")
    if not raw:
        return {"currentInputPrompt": raw}

    # If the raw is already plain text (no JSON braces), we can optionally skip LLM call
    # but for robustness, we still call the LLM to confirm/extract.
    if _clean_fn is not None:
        try:
            result = await kernel.invoke(_clean_fn, raw_text=raw)
            data = extract_json(str(result)) or {}
            clean = data.get("clean_prompt")
            if isinstance(clean, str) and clean.strip():
                print(f"    [CleanPrompt] LLM extracted -> '{clean.strip()}'")
                return {"currentInputPrompt": clean.strip()}
        except Exception as e:
            print(f"[!] CleanPrompt LLM failed: {e} -> using manual parse fallback")

    # Fallback: use the existing parse_rewrite_output on the raw (or the deterministic value)
    manual = parse_rewrite_output(raw)
    if manual:
        print(f"    [CleanPrompt] Manual fallback -> '{manual}'")
        return {"currentInputPrompt": manual}
    return {"currentInputPrompt": raw}  # last resort, return unchanged


