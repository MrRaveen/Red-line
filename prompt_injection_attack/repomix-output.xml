def salvage_json_string_value(text: str) -> str:
    """Tolerantly pull the value of 'modified_text'/'clean_prompt' out of
    malformed or truncated JSON, e.g. '{"modified_text": "Substitute 1 ...'."""
    m = re.search(r'"\s*:\s*"(.*)', text, re.DOTALL)
    if m:
        val = m.group(1).rstrip().rstrip('"').rstrip("}").strip()
        return val
    return ""


async def improve_phrase(state: graphState) -> Dict[str, Any]:
