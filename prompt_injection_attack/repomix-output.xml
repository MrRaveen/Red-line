def is_broken_json(text: str) -> bool:
    """True if text looks like JSON the model emitted but didn't close properly."""
    t = text.strip()
    if not (t.startswith("{") or '"modified_text"' in t or '"clean_prompt"' in t):
        return False
    try:
        json.loads(t)
        return False
    except Exception:
