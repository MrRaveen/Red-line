            except Exception as e:
                print(f"[!] Groq call failed for '{w}': {e}")

        if candidates and goal_vec is not None:
            v_vecs = embedder.encode(candidates)
            best = max(zip(candidates, v_vecs), key=lambda vv: cosine(vv[1], goal_vec))
            improved[w] = best[0]
        else:
