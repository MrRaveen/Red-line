<file path="kafka-streams/docker-compose.yml">
#only use this doe development via docker compose up -d to up kafka.
#use docker compose at the root level to up this in release branch.

#for each listener I have, here's the address to reach me through that specific listener.
#It's a per-listener address mapping, not one single address for the broker. Each entry pairs a listener name with the address a client should use if it's connecting via that listener:
#client --> listener --> brocker --> topics --> partitions
#first client --> get details about the cluster from boostrap server request defined in client separately via the container port mapping--> then connect to the brocker, topic and partition. 

#A single Kafka broker (one JVM process, one node ID) can open several listener sockets simultaneously — that's exactly what the earlier INTERNAL/EXTERNAL/CONTROLLER example showed:
# KAFKA_ADVERTISED_LISTENERS is the broker's address — or, when there are multiple listeners, the broker's set of addresses, one per listener, each valid only for clients connecting through that specific listener.
services:
  kafka:
    image: confluentinc/cp-kafka:7.6.1
    container_name: kafka
    ports:
      - "9093:9093"
      - "9094:9094"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: INTERNAL://0.0.0.0:9092,EXTERNAL://0.0.0.0:9094,CONTROLLER://0.0.0.0:9093
      KAFKA_ADVERTISED_LISTENERS: INTERNAL://kafka:9092,EXTERNAL://localhost:9094
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      CLUSTER_ID: "MkU3OEVBNTcwNTJENDM2Qk"
    volumes:
      - kafka_data:/var/lib/kafka/data

  kafka-ui:
    image: provectuslabs/kafka-ui:latest
    container_name: kafka-ui
    ports:
      - "8080:8080"
    environment:
      KAFKA_CLUSTERS_0_NAME: local
      KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS: kafka:9092
    depends_on:
      - kafka

  faust-worker:
    build: .
    container_name: streamer-worker
    volumes:
      - .:/app
    depends_on:
      - kafka

volumes:
  kafka_data:
</file>

